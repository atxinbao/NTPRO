{
  "openapi": "3.1.0",
  "info": {
    "title": "NTPRO Product API",
    "version": "1.0.0",
    "description": "策略工作台 Strategy、StrategyVersion 和 Run 产品资源的权威只读合同。"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "x-ntpro-authoritative-contract": true,
  "servers": [
    {
      "url": "/api/product/v1"
    }
  ],
  "paths": {
    "/strategies": {
      "get": {
        "operationId": "listStrategies",
        "summary": "读取策略列表",
        "security": [
          { "InstitutionCookie": [] },
          { "OperatorCookie": [] }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["strategy_id", "name", "updated_at"],
              "default": "strategy_id"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc"
            }
          },
          {
            "name": "lifecycle",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/StrategyLifecycle"
            }
          },
          {
            "name": "owner",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        ],
        "responses": {
          "200": {
            "description": "策略列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProductError"
          },
          "403": {
            "$ref": "#/components/responses/ProductError"
          },
          "405": {
            "$ref": "#/components/responses/ProductMethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/ProductError"
          },
          "503": {
            "$ref": "#/components/responses/ProductError"
          }
        }
      }
    },
    "/strategies/{strategy_id}": {
      "get": {
        "operationId": "getStrategy",
        "summary": "读取策略详情",
        "security": [
          { "InstitutionCookie": [] },
          { "OperatorCookie": [] }
        ],
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/StrategyId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "策略详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyDetailResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProductError"
          },
          "404": {
            "$ref": "#/components/responses/ProductError"
          },
          "403": {
            "$ref": "#/components/responses/ProductError"
          },
          "405": {
            "$ref": "#/components/responses/ProductMethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/ProductError"
          },
          "503": {
            "$ref": "#/components/responses/ProductError"
          }
        }
      }
    },
    "/strategies/{strategy_id}/versions": {
      "get": {
        "operationId": "listStrategyVersions",
        "summary": "读取策略版本列表",
        "security": [
          { "InstitutionCookie": [] },
          { "OperatorCookie": [] }
        ],
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/StrategyId"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["strategy_version_id", "version", "created_at"],
              "default": "strategy_version_id"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/StrategyVersionStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "不可变策略版本列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyVersionListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProductError"
          },
          "403": {
            "$ref": "#/components/responses/ProductError"
          },
          "404": {
            "$ref": "#/components/responses/ProductError"
          },
          "405": {
            "$ref": "#/components/responses/ProductMethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/ProductError"
          },
          "503": {
            "$ref": "#/components/responses/ProductError"
          }
        }
      }
    },
    "/strategies/{strategy_id}/versions/{version_id}": {
      "get": {
        "operationId": "getStrategyVersion",
        "summary": "读取策略版本详情",
        "security": [
          { "InstitutionCookie": [] },
          { "OperatorCookie": [] }
        ],
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/StrategyId"
            }
          },
          {
            "name": "version_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/StrategyVersionId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "不可变策略版本详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyVersionDetailResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProductError"
          },
          "403": {
            "$ref": "#/components/responses/ProductError"
          },
          "404": {
            "$ref": "#/components/responses/ProductError"
          },
          "405": {
            "$ref": "#/components/responses/ProductMethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/ProductError"
          },
          "503": {
            "$ref": "#/components/responses/ProductError"
          }
        }
      }
    },
    "/runs": {
      "get": {
        "operationId": "listRuns",
        "summary": "读取三环境运行记录列表",
        "security": [
          { "InstitutionCookie": [] },
          { "OperatorCookie": [] }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["run_id", "created_at", "updated_at"],
              "default": "run_id"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" }
          },
          {
            "name": "strategy_id",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/StrategyId" }
          },
          {
            "name": "strategy_version_id",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/StrategyVersionId" }
          },
          {
            "name": "environment",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/RunEnvironment" }
          },
          {
            "name": "lifecycle",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/RunLifecycle" }
          }
        ],
        "responses": {
          "200": {
            "description": "Run 列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RunListResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProductError" },
          "403": { "$ref": "#/components/responses/ProductError" },
          "405": { "$ref": "#/components/responses/ProductMethodNotAllowed" },
          "500": { "$ref": "#/components/responses/ProductError" },
          "503": { "$ref": "#/components/responses/ProductError" }
        }
      }
    },
    "/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "summary": "读取运行记录详情",
        "security": [
          { "InstitutionCookie": [] },
          { "OperatorCookie": [] }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/RunId" }
          }
        ],
        "responses": {
          "200": {
            "description": "Run 详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RunDetailResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProductError" },
          "403": { "$ref": "#/components/responses/ProductError" },
          "404": { "$ref": "#/components/responses/ProductError" },
          "405": { "$ref": "#/components/responses/ProductMethodNotAllowed" },
          "500": { "$ref": "#/components/responses/ProductError" },
          "503": { "$ref": "#/components/responses/ProductError" }
        }
      }
    },
    "/runs/{run_id}/metrics": {
      "get": {
        "operationId": "getRunMetrics",
        "summary": "读取已完成 Backtest 的不可变指标",
        "security": [
          { "InstitutionCookie": [] },
          { "OperatorCookie": [] }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/RunId" }
          }
        ],
        "responses": {
          "200": {
            "description": "Backtest 指标",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RunMetricsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProductError" },
          "403": { "$ref": "#/components/responses/ProductError" },
          "404": { "$ref": "#/components/responses/ProductError" },
          "405": { "$ref": "#/components/responses/ProductMethodNotAllowed" },
          "500": { "$ref": "#/components/responses/ProductError" },
          "503": { "$ref": "#/components/responses/ProductError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InstitutionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ntpro_mvp_institution_access"
      },
      "OperatorCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ntpro_mvp_operator_access"
      }
    },
    "responses": {
      "ProductError": {
        "description": "产品 API 稳定错误",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProductErrorResponse"
            }
          }
        }
      },
      "ProductMethodNotAllowed": {
        "description": "产品 API 仅允许 GET",
        "headers": {
          "Allow": {
            "required": true,
            "schema": {
              "type": "string",
              "const": "GET"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProductErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "StrategyId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.:-]+$"
      },
      "StrategyVersionId": {
        "type": "string",
        "minLength": 3,
        "maxLength": 257,
        "pattern": "^(?!\\.{1,2}@)[A-Za-z0-9_.:-]{1,128}@(?!\\.{1,2}$)[A-Za-z0-9_.:-]{1,128}$"
      },
      "ContentHash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "RequestId": {
        "type": "string",
        "pattern": "^product-[0-9a-f]{16}-[0-9a-f]{16}$"
      },
      "StrategyLifecycle": {
        "type": "string",
        "enum": ["draft", "active", "archived"]
      },
      "ProductSource": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "freshness_status", "source_refs"],
        "properties": {
          "source_type": {
            "const": "mvp_identity_config"
          },
          "freshness_status": {
            "const": "fresh"
          },
          "source_refs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "StrategyVersionSource": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "freshness_status", "source_refs"],
        "properties": {
          "source_type": {
            "const": "strategy_version_manifest"
          },
          "freshness_status": {
            "const": "fresh"
          },
          "source_refs": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "Strategy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy_id",
          "name",
          "description",
          "owner",
          "lifecycle",
          "default_version_id",
          "created_at_unix_ms",
          "updated_at_unix_ms",
          "source"
        ],
        "properties": {
          "strategy_id": {
            "$ref": "#/components/schemas/StrategyId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "lifecycle": {
            "$ref": "#/components/schemas/StrategyLifecycle"
          },
          "default_version_id": {
            "$ref": "#/components/schemas/StrategyVersionId"
          },
          "created_at_unix_ms": {
            "type": "integer",
            "minimum": 1
          },
          "updated_at_unix_ms": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "$ref": "#/components/schemas/ProductSource"
          }
        }
      },
      "StrategyVersionStatus": {
        "type": "string",
        "enum": ["registered"]
      },
      "StrategyVersionDataRequirements": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "venues",
          "symbols",
          "data_types",
          "timeframes",
          "deterministic_replay_required"
        ],
        "properties": {
          "venues": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "symbols": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "data_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "timeframes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "deterministic_replay_required": {
            "const": true
          }
        }
      },
      "StrategyVersionRiskConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk_profile_ref",
          "kill_switch_required",
          "external_venue_connection_default",
          "order_submission_default"
        ],
        "properties": {
          "risk_profile_ref": {
            "const": "node-config:#risk"
          },
          "kill_switch_required": {
            "const": true
          },
          "external_venue_connection_default": {
            "const": false
          },
          "order_submission_default": {
            "const": false
          }
        }
      },
      "StrategyVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy_version_id",
          "strategy_id",
          "version",
          "content_hash",
          "code_ref",
          "parameter_schema",
          "data_requirements",
          "risk_config",
          "status",
          "created_at_unix_ms",
          "source"
        ],
        "properties": {
          "strategy_version_id": {
            "$ref": "#/components/schemas/StrategyVersionId"
          },
          "strategy_id": {
            "$ref": "#/components/schemas/StrategyId"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.:-]+$"
          },
          "content_hash": {
            "$ref": "#/components/schemas/ContentHash"
          },
          "code_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^git://NTPRO@[0-9a-f]{40}/crates/cli/src/strategy_session\\.rs#ema_cross_demo$"
          },
          "parameter_schema": {
            "type": "object",
            "required": ["$schema", "type", "additionalProperties", "required", "properties"]
          },
          "data_requirements": {
            "$ref": "#/components/schemas/StrategyVersionDataRequirements"
          },
          "risk_config": {
            "$ref": "#/components/schemas/StrategyVersionRiskConfig"
          },
          "status": {
            "$ref": "#/components/schemas/StrategyVersionStatus"
          },
          "created_at_unix_ms": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "$ref": "#/components/schemas/StrategyVersionSource"
          }
        }
      },
      "RunId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.:-]+$"
      },
      "RunEnvironment": {
        "type": "string",
        "enum": ["backtest", "sandbox", "live"]
      },
      "RunLifecycle": {
        "type": "string",
        "enum": ["created", "queued", "running", "stopping", "completed", "failed", "cancelled", "stopped"]
      },
      "RunResultStatus": {
        "type": "string",
        "enum": ["pending", "available", "unavailable"]
      },
      "RunRiskStatus": {
        "type": "string",
        "enum": ["pending", "active", "passed", "blocked"]
      },
      "RunSource": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "freshness_status", "source_refs"],
        "properties": {
          "source_type": { "const": "run_manifest" },
          "freshness_status": { "const": "fresh" },
          "source_refs": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "RunResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "result_ref"],
        "properties": {
          "status": { "$ref": "#/components/schemas/RunResultStatus" },
          "result_ref": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "RunRisk": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "risk_ref"],
        "properties": {
          "status": { "$ref": "#/components/schemas/RunRiskStatus" },
          "risk_ref": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      },
      "RunError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "summary"],
        "properties": {
          "code": { "$ref": "#/components/schemas/RunId" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "RunCapabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_venue_connection",
          "order_submission_allowed",
          "order_mutation_allowed",
          "automatic_retry_allowed",
          "automatic_remediation_allowed",
          "real_orders_submitted",
          "trading_controls_enabled"
        ],
        "properties": {
          "external_venue_connection": { "const": false },
          "order_submission_allowed": { "const": false },
          "order_mutation_allowed": { "const": false },
          "automatic_retry_allowed": { "const": false },
          "automatic_remediation_allowed": { "const": false },
          "real_orders_submitted": { "const": false },
          "trading_controls_enabled": { "const": false }
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "strategy_id",
          "strategy_version_id",
          "environment",
          "data_ref",
          "config_ref",
          "adapter_ref",
          "account_ref",
          "venue_ref",
          "lifecycle",
          "result",
          "risk",
          "error",
          "created_at_unix_ms",
          "started_at_unix_ms",
          "completed_at_unix_ms",
          "updated_at_unix_ms",
          "source",
          "capabilities"
        ],
        "properties": {
          "run_id": { "$ref": "#/components/schemas/RunId" },
          "strategy_id": { "$ref": "#/components/schemas/StrategyId" },
          "strategy_version_id": { "$ref": "#/components/schemas/StrategyVersionId" },
          "environment": { "$ref": "#/components/schemas/RunEnvironment" },
          "data_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "config_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "adapter_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "account_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "venue_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "lifecycle": { "$ref": "#/components/schemas/RunLifecycle" },
          "result": { "$ref": "#/components/schemas/RunResult" },
          "risk": { "$ref": "#/components/schemas/RunRisk" },
          "error": {
            "oneOf": [
